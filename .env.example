DB_HOST=host
DB_PORT=port
DB_USERNAME=username
DB_PASSWORD=password
DB_NAME=postgres
DB_SSL=true

NODE_ENV=development
SERVICE_NAME=hospital-management-api

# CORS (comma-separated full origins: scheme + host + port)
# CORS_ALLOWED_HOSTS=http://localhost:5173,http://localhost:3000
# CORS_CREDENTIALS=true

# JWT authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Seed scripts (optional)
# SEED_DEFAULT_PASSWORD=Doctor@123
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Swagger UI
# On Vercel, Swagger defaults to /docs (not /api) and loads assets from CDN.
# SWAGGER_PATH=docs
# SWAGGER_USE_CDN=true
# ENABLE_SWAGGER=false
