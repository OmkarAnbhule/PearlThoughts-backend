DB_HOST=host
DB_PORT=port
DB_USERNAME=username
DB_PASSWORD=password
DB_NAME=postgres
DB_SSL=true

NODE_ENV=development
SERVICE_NAME=hospital-management-api
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Swagger UI
# On Vercel, Swagger defaults to /docs (not /api) and loads assets from CDN.
# SWAGGER_PATH=docs
# SWAGGER_USE_CDN=true
# ENABLE_SWAGGER=false
